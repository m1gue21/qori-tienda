---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { productos, categorias } from '../data/products';

const colecciones = ['Clover', 'Romance', 'Esenciales'] as const;
const filtros = [{ id: 'todo', nombre: 'Todo' }, ...categorias.map(({ id, nombre }) => ({ id, nombre }))];
---

<Layout title="Colección" description="Aretes, collares, pulseras, anillos y cadenas en oro laminado 18K. Envíos a todo el Ecuador.">
  <section class="bg-sand pt-[6.25rem]">
    <div class="mx-auto max-w-7xl px-4 pb-14 pt-16 sm:px-8 lg:pt-24">
      <nav class="text-[0.65rem] uppercase tracking-[0.25em] text-stone" aria-label="Ruta">
        <a href="/" class="hover:text-ink">Inicio</a> <span class="mx-2">/</span> <span class="text-ink">Colección</span>
      </nav>
      <h1 class="mt-6 font-display text-6xl font-light sm:text-7xl">La colección</h1>
      <p class="mt-4 max-w-xl text-lg text-stone">Cada pieza en oro laminado 18K, inspirada en la belleza y la historia del Ecuador.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-8 lg:py-16">
    <div class="flex flex-col gap-6 border-b border-ink/10 pb-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" role="group" aria-label="Filtrar por tipo">
        {
          filtros.map((f) => (
            <button
              type="button"
              data-filter={f.id}
              aria-pressed={f.id === 'todo' ? 'true' : 'false'}
              class="shrink-0 border border-ink/15 px-5 py-2.5 text-[0.68rem] uppercase tracking-[0.22em] transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-ivory"
            >
              {f.nombre}
            </button>
          ))
        }
      </div>
      <div class="flex items-center gap-4 text-[0.68rem] uppercase tracking-[0.22em] text-stone">
        <label for="col" class="shrink-0">Colección</label>
        <select id="col" class="border-b border-ink/30 bg-transparent py-2 pr-6 text-ink focus:outline-none">
          <option value="">Todas</option>
          {colecciones.map((c) => <option value={c}>{c}</option>)}
        </select>
        <span id="count" class="ml-auto shrink-0 lg:ml-4" aria-live="polite"></span>
      </div>
    </div>

    <div id="grid" class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-4">
      {
        productos.map((p, i) => (
          <div data-item data-cat={p.categoria} data-col={p.coleccion ?? ''}>
            <ProductCard producto={p} delay={(i % 4) * 70} />
          </div>
        ))
      }
    </div>
    <p id="empty" class="hidden py-24 text-center font-display text-2xl text-stone">
      No hay piezas con ese filtro todavía. <button type="button" id="reset" class="underline underline-offset-4">Ver todo</button>
    </p>
  </section>
</Layout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const select = document.getElementById('col') as HTMLSelectElement;
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;

  const params = new URLSearchParams(location.search);
  let cat = params.get('c') ?? 'todo';
  if (!buttons.some((b) => b.dataset.filter === cat)) cat = 'todo';
  select.value = params.get('col') ?? '';

  function apply() {
    const col = select.value;
    let visibles = 0;
    for (const el of items) {
      const show = (cat === 'todo' || el.dataset.cat === cat) && (!col || el.dataset.col === col);
      el.hidden = !show;
      if (show) {
        visibles++;
        el.querySelector('[data-reveal]')?.classList.add('is-visible');
      }
    }
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    count.textContent = `${visibles} ${visibles === 1 ? 'pieza' : 'piezas'}`;
    empty.classList.toggle('hidden', visibles > 0);

    const url = new URL(location.href);
    cat === 'todo' ? url.searchParams.delete('c') : url.searchParams.set('c', cat);
    col ? url.searchParams.set('col', col) : url.searchParams.delete('col');
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.filter!;
      apply();
    }),
  );
  select.addEventListener('change', apply);
  document.getElementById('reset')!.addEventListener('click', () => {
    cat = 'todo';
    select.value = '';
    apply();
  });
  apply();
</script>
