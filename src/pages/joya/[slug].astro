---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { productos, getCategoria, type Producto } from '../../data/products';
import { orderLink, orderChannel } from '../../data/site';

export const getStaticPaths = (() =>
  productos.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }))) satisfies GetStaticPaths;

const { producto } = Astro.props as { producto: Producto };
const categoria = getCategoria(producto.categoria);
const imagenes = [producto.imagen, ...(producto.galeria ?? [])];
const mensaje = `Hola Qori, me interesa la pieza "${producto.nombre}". ¿Está disponible?`;

const relacionados = productos
  .filter((p) => p.slug !== producto.slug)
  .sort((a, b) => {
    const score = (p: Producto) => (p.coleccion === producto.coleccion ? 2 : 0) + (p.categoria === producto.categoria ? 1 : 0);
    return score(b) - score(a);
  })
  .slice(0, 4);
---

<Layout title={producto.nombre} description={`${producto.nombre}: ${producto.resumen} Oro laminado 18K, envíos a todo el Ecuador.`}>
  <section class="mx-auto max-w-7xl px-4 pb-24 pt-[8.5rem] sm:px-8 lg:pt-[9.5rem]">
    <nav class="text-[0.65rem] uppercase tracking-[0.25em] text-stone" aria-label="Ruta">
      <a href="/" class="hover:text-ink">Inicio</a><span class="mx-2">/</span>
      <a href="/coleccion" class="hover:text-ink">Colección</a><span class="mx-2">/</span>
      <a href={`/coleccion?c=${categoria.id}`} class="hover:text-ink">{categoria.nombre}</a>
    </nav>

    <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class:list={['grid gap-4', imagenes.length > 1 && 'sm:grid-cols-2']}>
          {
            imagenes.map((img, i) => (
              <div class="overflow-hidden bg-sand">
                <Image
                  src={img}
                  alt={i === 0 ? producto.nombre : `${producto.nombre}, vista ${i + 1}`}
                  widths={[400, img.width]}
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class:list={['w-full object-cover', imagenes.length > 1 ? 'aspect-[3/5] sm:h-full' : 'aspect-[4/5]']}
                />
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-36">
          {producto.coleccion && <p class="eyebrow">Colección {producto.coleccion}</p>}
          <h1 class="mt-4 font-display text-5xl font-light leading-[1.05] sm:text-6xl">{producto.nombre}</h1>
          <p class="mt-5 font-display text-2xl italic text-ink/70">{producto.resumen}</p>
          <p class="mt-6 leading-relaxed text-stone">{producto.descripcion}</p>

          <ul class="mt-8 divide-y divide-ink/10 border-y border-ink/10">
            {
              producto.detalles.map((d) => (
                <li class="flex items-center gap-4 py-3.5 text-sm">
                  <span class="size-1.5 rotate-45 bg-gold" />
                  {d}
                </li>
              ))
            }
          </ul>

          <div class="mt-8 bg-sand p-6">
            <p class="text-[0.65rem] uppercase tracking-[0.25em] text-stone">Precio</p>
            <p class="mt-1 font-display text-2xl">Consúltalo por {orderChannel()}</p>
            <p class="mt-1 text-sm text-stone">Precios especiales al por mayor.</p>
          </div>

          <a href={orderLink(mensaje)} target="_blank" rel="noopener" class="btn-dark mt-6 w-full">
            Pedir esta pieza
          </a>
          <button type="button" id="copy" data-text={mensaje} class="mt-3 w-full py-2 text-xs uppercase tracking-[0.2em] text-stone hover:text-ink">
            Copiar mensaje de pedido
          </button>

          <div class="mt-8 grid grid-cols-3 gap-3 text-center text-[0.62rem] uppercase tracking-[0.2em] text-stone">
            <div class="border border-ink/10 px-2 py-4">Oro laminado<br /><span class="text-ink">18K</span></div>
            <div class="border border-ink/10 px-2 py-4">Envíos<br /><span class="text-ink">Todo Ecuador</span></div>
            <div class="border border-ink/10 px-2 py-4">Compra<br /><span class="text-ink">100% segura</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-sand/60">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-8">
      <h2 class="font-display text-4xl font-light">También te puede gustar</h2>
      <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-4">
        {relacionados.map((p, i) => <ProductCard producto={p} delay={i * 80} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('copy') as HTMLButtonElement;
  btn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.text ?? '');
      btn.textContent = 'Mensaje copiado ✓';
    } catch {
      btn.textContent = 'No se pudo copiar';
    }
    setTimeout(() => (btn.textContent = 'Copiar mensaje de pedido'), 2500);
  });
</script>
