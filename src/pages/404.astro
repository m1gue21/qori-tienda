---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <section class="mx-auto flex min-h-[80vh] max-w-xl flex-col items-center justify-center px-4 pt-[6.25rem] text-center">
    <span class="qori-mark block w-24 bg-gold"></span>
    <h1 class="mt-8 font-display text-6xl font-light">Esta joya se perdió</h1>
    <p class="mt-4 text-stone">La página que buscas no existe o cambió de lugar.</p>
    <a href="/coleccion" class="btn-dark mt-10">Ver la colección</a>
  </section>
</Layout>
