---
import { orderLink } from '../data/site';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/coleccion', label: 'Colección' },
  { href: '/#clover', label: 'Clover' },
  { href: '/#historia', label: 'Nuestra historia' },
  { href: '/#mayoristas', label: 'Mayoristas' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---

<header
  id="site-header"
  data-overlay={overlay ? 'true' : 'false'}
  class="group/header fixed inset-x-0 top-0 z-50 transition-colors duration-500"
>
  <div class="bg-ink text-ivory/80">
    <p class="mx-auto max-w-7xl px-4 py-2 text-center text-[0.65rem] uppercase tracking-[0.3em] sm:px-8">
      Envíos a todo el Ecuador<span class="hidden sm:inline"> · Oro laminado 18K</span>
    </p>
  </div>
  <div
    id="header-bar"
    class="border-b border-transparent transition-all duration-500 ease-lux data-[solid=true]:border-ink/10 data-[solid=true]:bg-ivory/90 data-[solid=true]:backdrop-blur-md"
    data-solid={overlay ? 'false' : 'true'}
  >
    <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-4 sm:px-8">
      <a href="/" class="flex items-center gap-3" aria-label="Qori Joyería, inicio">
        <span class="qori-mark block h-7 bg-gold-deep"></span>
        <span class="font-brand text-xl tracking-[0.3em] text-ink">QORI</span>
      </a>

      <nav class="hidden lg:block" aria-label="Principal">
        <ul class="flex items-center gap-9 text-[0.72rem] uppercase tracking-[0.22em]">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['link-underline py-1 transition-colors hover:text-gold-deep', path.startsWith(item.href) && item.href !== '/' && 'text-gold-deep']}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <a href={orderLink()} target="_blank" rel="noopener" class="btn-dark hidden px-5 py-2.5 sm:inline-flex">
          Hacer pedido
        </a>
        <button
          id="menu-toggle"
          type="button"
          class="grid size-11 place-items-center lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú"
        >
          <span class="relative block h-3 w-6">
            <span class="absolute inset-x-0 top-0 h-px bg-ink transition-transform duration-500 ease-lux [[aria-expanded=true]_&]:translate-y-1.5 [[aria-expanded=true]_&]:rotate-45"></span>
            <span class="absolute inset-x-0 bottom-0 h-px bg-ink transition-transform duration-500 ease-lux [[aria-expanded=true]_&]:-translate-y-1.5 [[aria-expanded=true]_&]:-rotate-45"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-x-0 bottom-0 top-[6.5rem] bg-ivory opacity-0 transition-opacity duration-500 ease-lux data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 lg:hidden"
    data-open="false"
  >
    <nav class="flex h-full flex-col justify-between px-6 pb-10 pt-8" aria-label="Menú móvil">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="block border-b border-ink/10 py-4 font-display text-3xl">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={orderLink()} target="_blank" rel="noopener" class="btn-dark w-full">Hacer pedido</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('header-bar')!;
  const overlay = document.getElementById('site-header')!.dataset.overlay === 'true';
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const setSolid = () => {
    const open = menu.dataset.open === 'true';
    header.dataset.solid = String(!overlay || open || window.scrollY > 40);
  };
  setSolid();
  window.addEventListener('scroll', setSolid, { passive: true });

  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';
    setSolid();
  };
  toggle.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
